# Source-only publication. Local reports, captures, builds and agent stages stay local.
/*
!/.gitignore
!/README.md
!/package.json
!/app/
!/desktop/
!/extension/
!/extension-next/
!/shared/
!/scripts/
!/tests/
!/docs/
!/releases/
/app/*
!/app/src/
!/app/index.html
!/app/package.json
!/app/package-lock.json
!/app/vite.config.mjs
/docs/*
!/docs/RELEASE-v0.2.8.md
/releases/*
!/releases/v0.2.8/
**/.DS_Store
**/node_modules/
**/dist/
**/.env
**/.env.*
**/*.localdoc
**/*.fdocpack.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
